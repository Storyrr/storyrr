# Copy to .env.local (git-ignored) and fill in. Validated at startup by src/server/env.ts.

# SQLite database file (in Docker: /data/storyrr.db on the data volume)
DATABASE_URL=database/dev.db

# Optional. The application URL used in links (emails, notifications, the
# Chaptarr webhook); otherwise set in the setup wizard / Settings → General.
# Storyrr works at any address it's reached at either way.
# BETTER_AUTH_URL=http://localhost:3000

# Optional. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Without it, a secret is generated in `auth-secret` next to the database.
# BETTER_AUTH_SECRET=

# HTTP port of the production server
PORT=3000
