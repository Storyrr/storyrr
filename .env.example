# Copy to .env.local (git-ignored) and fill in. Validated at startup by src/server/env.ts.

# SQLite database file (in Docker: /data/storyrr.db on the data volume)
DATABASE_URL=dev.db

# Public base URL of the app (used for auth redirects and cookies)
BETTER_AUTH_URL=http://localhost:3000

# At least 32 random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=

# HTTP port of the production server
PORT=3000
