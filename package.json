{
  "name": "storyrr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --silent",
    "check": "bun run i18n:compile && bun run format:check && bun run lint && bun run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@inlang/paraglide-js": "3.2.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-query-devtools": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "^1.5.3",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "croner": "11.0.1",
    "drizzle-orm": "^1.0.0-rc.6",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260610-beta",
    "nodemailer": "10.6.1",
    "react": "^19.2.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "undici": "7.30.2",
    "valibot": "1.5.0",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/intent": "0.5.6",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^1.0.0-rc.6",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
