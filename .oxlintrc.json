{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    // React 19 automatic JSX runtime: importing React in every file is not needed.
    "react/react-in-jsx-scope": "off",
    // Side-effect-only imports are intentional for these modules.
    // "@tanstack/react-start/server-only" marks a file server-only (build fails if the client imports it).
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["@tanstack/react-start/server-only", "**/*.css"] }
    ]
  },
  "overrides": [
    {
      // Vendored shadcn/ui (aria-nova) components, regenerated by the shadcn CLI.
      // Their interaction patterns are intentional and React Aria handles keyboard/ARIA:
      // the input group forwards clicks to its input, the select search field autofocuses.
      // Fix upstream rather than editing these files.
      // The dropdown menu spells out React Aria's default generic arguments.
      "files": ["src/components/ui/**"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-autofocus": "off",
        "eslint/no-shadow": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-arguments": "off"
      }
    }
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/paraglide/**",
    "drizzle/**",
    ".output/**",
    // Agent skills (examples inside are not project code)
    ".claude/**",
    ".agents/**"
  ]
}
